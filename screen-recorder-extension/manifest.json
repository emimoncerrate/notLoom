{
  "manifest_version": 3,
  "name": "Screen Recorder with Audio",
  "version": "1.0.0",
  "description": "Record your screen with audio and floating controls",
  
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Start Screen Recording",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  
  "content_scripts": [],
  
  "web_accessible_resources": [
    {
      "resources": ["floating-controls.css"],
      "matches": ["<all_urls>"]
    }
  ]
}